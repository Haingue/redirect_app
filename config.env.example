# Configuration de l'application de redirection
# Modifiez ces valeurs puis redémarrez l'exécutable (aucune recompilation nécessaire).

# URL de destination affichée et utilisée pour la redirection
REDIRECT_URL=https://nouvelle-adresse.exemple.com

# Titre affiché en haut de la page (entourez la valeur de guillemets doubles)
REDIRECT_MESSAGE_TITLE="Cette page a déménagé"

# Message affiché à l'utilisateur (entourez la valeur de guillemets doubles)
REDIRECT_MESSAGE="Cette application a été déplacée vers une nouvelle adresse. Merci de mettre à jour vos favoris et raccourcis."

# Délai avant redirection automatique (en secondes)
REDIRECT_DELAY_SECONDS=10

# Adresse et port d'écoute du serveur
LISTEN_ADDR=0.0.0.0:8080
